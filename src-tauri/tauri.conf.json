{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Identity V Assistant",
  "version": "0.1.0",
  "identifier": "io.github.identityv-assistant",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Identity V Assistant",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
