{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Identity V Assistant",
  "version": "0.1.1",
  "identifier": "io.github.identityv-assistant",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/prepare_release.ps1",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Identity V Assistant",
        "width": 1000,
        "height": 680,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMUNBQUVDMUQ1M0I5NTIKUldSU3VWTWQ3S29jZ0Z3aTRXdms0V1Q0c0s0c3dKbnZ4a25kdUIwa3pNaGh4aXBaMlhtQytQTlIK",
      "endpoints": ["https://github.com/WaltomAdaam2/IdentityV-Assistant/releases/latest/download/latest.json"],
      "windows": {"installMode": "passive"}
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["nsis"],
    "publisher": "Identity V Assistant contributors",
    "homepage": "https://github.com/WaltomAdaam2/IdentityV-Assistant",
    "licenseFile": "../LICENSE",
    "shortDescription": "第五人格助手与加页手记地图浏览",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../engine/dist/identityv-engine/": "engine/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Identity V Assistant"
      }
    }
  }
}
